# Local Development Environment Configuration
# Copy this file to .env.local and fill in your values

# CloudFront URL (REQUIRED for local development)
# Get this from CDK stack outputs after deployment
# Example: https://d1a2b3c4d5e6f7.cloudfront.net
VITE_CLOUDFRONT_URL=

# Optional: Override API base URL (defaults to /api which uses Vite proxy)
# Only set this if you want to bypass the proxy and call CloudFront directly
# VITE_API_BASE_URL=

# Optional: Development mode flag (defaults to true)
# VITE_DEV_MODE=true
