{
  "Comment": "DeleteChannel: best-effort cleanup of all channel resources. Each step catches errors and continues to the next. After DeleteMediaLiveChannel returns, polls DescribeChannel until the channel is fully deleted before attempting DeleteMediaLiveInput, since the input cannot be deleted while still attached to a channel in DELETING state.",
  "StartAt": "InitDeleteState",
  "States": {
    "InitDeleteState": {
      "Type": "Pass",
      "Parameters": {
        "channelId.$": "$.channelId",
        "inputId.$": "$.inputId",
        "feedId.$": "$.feedId",
        "channelGroupName.$": "$.channelGroupName",
        "mediaPackageChannelName.$": "$.mediaPackageChannelName",
        "originEndpointName.$": "$.originEndpointName",
        "landscapeEndpointName.$": "$.landscapeEndpointName",
        "verticalEndpointName.$": "$.verticalEndpointName",
        "deletePollAttempts": 0
      },
      "Next": "DeleteMediaLiveChannel"
    },
    "DeleteMediaLiveChannel": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${MediaLiveClientFunctionArn}",
        "Payload": {
          "action": "delete_channel",
          "params": {
            "channel_id.$": "$.channelId"
          }
        }
      },
      "ResultPath": null,
      "Next": "WaitForChannelDelete",
      "Catch": [{ "ErrorEquals": ["States.ALL"], "ResultPath": null, "Next": "WaitForChannelDelete" }]
    },
    "WaitForChannelDelete": {
      "Type": "Wait",
      "Seconds": 10,
      "Next": "DescribeChannelForDelete"
    },
    "DescribeChannelForDelete": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${MediaLiveClientFunctionArn}",
        "Payload": {
          "action": "describe_channel",
          "params": {
            "channel_id.$": "$.channelId"
          }
        }
      },
      "ResultSelector": {
        "parsed.$": "States.StringToJson($.Payload.body)"
      },
      "ResultPath": "$.describeResult",
      "Next": "EvaluateChannelDeleteStatus",
      "Catch": [{ "ErrorEquals": ["States.ALL"], "ResultPath": null, "Next": "IncrementDeletePollAttempts" }]
    },
    "EvaluateChannelDeleteStatus": {
      "Type": "Choice",
      "Comment": "Channel is gone when channelExists=false (NotFound) or State=DELETED.",
      "Choices": [
        { "Variable": "$.describeResult.parsed.channel.channelExists", "BooleanEquals": false, "Next": "DeleteMediaLiveInput" },
        { "Variable": "$.describeResult.parsed.channel.State", "StringEquals": "DELETED", "Next": "DeleteMediaLiveInput" }
      ],
      "Default": "IncrementDeletePollAttempts"
    },
    "IncrementDeletePollAttempts": {
      "Type": "Pass",
      "Parameters": {
        "channelId.$": "$.channelId",
        "inputId.$": "$.inputId",
        "feedId.$": "$.feedId",
        "channelGroupName.$": "$.channelGroupName",
        "mediaPackageChannelName.$": "$.mediaPackageChannelName",
        "originEndpointName.$": "$.originEndpointName",
        "landscapeEndpointName.$": "$.landscapeEndpointName",
        "verticalEndpointName.$": "$.verticalEndpointName",
        "deletePollAttempts.$": "States.MathAdd($.deletePollAttempts, 1)"
      },
      "Next": "CheckDeletePollAttempts"
    },
    "CheckDeletePollAttempts": {
      "Type": "Choice",
      "Comment": "Bound poll loop to ~3 minutes (18 * 10s) before giving up and attempting input delete anyway.",
      "Choices": [
        { "Variable": "$.deletePollAttempts", "NumericGreaterThanEquals": 18, "Next": "DeleteMediaLiveInput" }
      ],
      "Default": "WaitForChannelDelete"
    },
    "DeleteMediaLiveInput": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${MediaLiveClientFunctionArn}",
        "Payload": {
          "action": "delete_input",
          "params": {
            "input_id.$": "$.inputId"
          }
        }
      },
      "ResultPath": null,
      "Retry": [
        {
          "ErrorEquals": ["InputBusyError"],
          "IntervalSeconds": 15,
          "MaxAttempts": 4,
          "BackoffRate": 1.5
        }
      ],
      "Next": "DeleteInferenceFeed",
      "Catch": [{ "ErrorEquals": ["States.ALL"], "ResultPath": null, "Next": "DeleteInferenceFeed" }]
    },
    "DeleteInferenceFeed": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${CreateFeedFunctionArn}",
        "Payload": {
          "action": "delete",
          "feedId.$": "$.feedId"
        }
      },
      "ResultPath": null,
      "Next": "DeleteEndpointPolicies",
      "Catch": [{ "ErrorEquals": ["States.ALL"], "ResultPath": null, "Next": "DeleteEndpointPolicies" }]
    },
    "DeleteEndpointPolicies": {
      "Type": "Task",
      "Comment": "Delete all 3 endpoint policies via Lambda",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${CreateFeedFunctionArn}",
        "Payload": {
          "action": "delete_endpoint_policies",
          "channelGroupName.$": "$.channelGroupName",
          "channelName.$": "$.mediaPackageChannelName",
          "endpoints.$": "States.Array($.originEndpointName, $.landscapeEndpointName, $.verticalEndpointName)"
        }
      },
      "ResultPath": null,
      "Next": "DeleteOriginEndpoints",
      "Catch": [{ "ErrorEquals": ["States.ALL"], "ResultPath": null, "Next": "DeleteOriginEndpoints" }]
    },
    "DeleteOriginEndpoints": {
      "Type": "Parallel",
      "Comment": "Delete all 3 origin endpoints",
      "ResultPath": null,
      "Next": "DeleteMediaPackageChannel",
      "Catch": [{ "ErrorEquals": ["States.ALL"], "ResultPath": null, "Next": "DeleteMediaPackageChannel" }],
      "Branches": [
        {
          "StartAt": "DeleteMainEndpoint",
          "States": {
            "DeleteMainEndpoint": {
              "Type": "Task",
              "Resource": "arn:aws:states:::aws-sdk:mediapackagev2:deleteOriginEndpoint",
              "Parameters": {
                "ChannelGroupName.$": "$.channelGroupName",
                "ChannelName.$": "$.mediaPackageChannelName",
                "OriginEndpointName.$": "$.originEndpointName"
              },
              "End": true,
              "Catch": [{ "ErrorEquals": ["States.ALL"], "ResultPath": null, "Next": "MainEpDone" }]
            },
            "MainEpDone": { "Type": "Pass", "End": true }
          }
        },
        {
          "StartAt": "DeleteLandscapeEndpoint",
          "States": {
            "DeleteLandscapeEndpoint": {
              "Type": "Task",
              "Resource": "arn:aws:states:::aws-sdk:mediapackagev2:deleteOriginEndpoint",
              "Parameters": {
                "ChannelGroupName.$": "$.channelGroupName",
                "ChannelName.$": "$.mediaPackageChannelName",
                "OriginEndpointName.$": "$.landscapeEndpointName"
              },
              "End": true,
              "Catch": [{ "ErrorEquals": ["States.ALL"], "ResultPath": null, "Next": "LandscapeEpDone" }]
            },
            "LandscapeEpDone": { "Type": "Pass", "End": true }
          }
        },
        {
          "StartAt": "DeleteVerticalEndpoint",
          "States": {
            "DeleteVerticalEndpoint": {
              "Type": "Task",
              "Resource": "arn:aws:states:::aws-sdk:mediapackagev2:deleteOriginEndpoint",
              "Parameters": {
                "ChannelGroupName.$": "$.channelGroupName",
                "ChannelName.$": "$.mediaPackageChannelName",
                "OriginEndpointName.$": "$.verticalEndpointName"
              },
              "End": true,
              "Catch": [{ "ErrorEquals": ["States.ALL"], "ResultPath": null, "Next": "VerticalEpDone" }]
            },
            "VerticalEpDone": { "Type": "Pass", "End": true }
          }
        }
      ]
    },
    "DeleteMediaPackageChannel": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:mediapackagev2:deleteChannel",
      "Parameters": {
        "ChannelGroupName.$": "$.channelGroupName",
        "ChannelName.$": "$.mediaPackageChannelName"
      },
      "ResultPath": null,
      "Next": "DeleteDynamoDBRecord",
      "Catch": [{ "ErrorEquals": ["States.ALL"], "ResultPath": null, "Next": "DeleteDynamoDBRecord" }]
    },
    "DeleteDynamoDBRecord": {
      "Type": "Task",
      "Resource": "arn:aws:states:::dynamodb:deleteItem",
      "Parameters": {
        "TableName": "${ChannelsTableName}",
        "Key": {
          "id": { "S.$": "$.channelId" }
        }
      },
      "ResultPath": null,
      "Next": "Success"
    },
    "Success": {
      "Type": "Succeed"
    }
  }
}